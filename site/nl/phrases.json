        { "id": "ik-neem-deze", "en": "I'll have this one, please", "text": "Ik neem deze, alstublieft", "ph": "ik NAYM DAY-zuh, ahl-stoo-BLEEFT" },
        { "id": "kraanwater", "en": "A glass of tap water", "text": "Een glas kraanwater, alstublieft", "ph": "un KHLAHS KRAHN-vah-tur, ahl-stoo-BLEEFT", "note": "Not always offered; asking is fine." },
        { "id": "nee-dank-u", "en": "No, thank you", "text": "Nee, dank u", "ph": "NAY, DAHNK oo" }
