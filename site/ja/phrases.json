  "sections": [
    {
      "id": "morning",
      "title": "Morning",
      "hours": [5, 11],
      "phrases": [
        { "id": "ohayou", "en": "Good morning", "text": "おはようございます", "rom": "ohayō gozaimasu", "ph": "oh-hah-yoh goh-zai-mahs", "note": "Casual: ohayō." },
        {
          "id": "koohii", "en": "A coffee, please", "text": "コーヒーをください", "rom": "kōhī o kudasai", "ph": "koh-hee oh koo-dah-sai",
          "replies": [
            { "id": "koohii-r1", "text": "サイズはいかがなさいますか？", "rom": "saizu wa ikaga nasaimasu ka", "en": "What size would you like?" },
            { "id": "koohii-r2", "text": "店内でお召し上がりですか？", "rom": "tennai de omeshiagari desu ka", "en": "Will you have it here?" }
          ]
        },
        { "id": "hotto-aisu", "en": "Hot / iced", "text": "ホット / アイス", "say": "ホット。アイス。", "rom": "hotto / aisu", "ph": "hoht-toh / ai-soo" },
        {
          "id": "mooningu", "en": "The morning set, please", "text": "モーニングセットをお願いします", "rom": "mōningu setto o onegai shimasu", "ph": "moh-neen-goo set-toh oh oh-neh-gai shee-mahs", "note": "Café breakfast deal: toast and egg with your coffee, usually until 11.",
          "replies": [
            { "id": "mooningu-r1", "text": "お飲み物は何になさいますか？", "rom": "onomimono wa nan ni nasaimasu ka", "en": "What would you like to drink?" }
          ]
        },
        { "id": "tennai-mochikaeri", "en": "To eat here / to take away", "text": "店内で / 持ち帰りで", "say": "店内で。持ち帰りで。", "rom": "tennai de / mochikaeri de", "ph": "ten-nai deh / moh-chee-kah-eh-ree deh", "note": "The counter will ask which; answer with one." },
        {
          "id": "atatamete", "en": "Please heat it up", "text": "温めてください", "rom": "atatamete kudasai", "ph": "ah-tah-tah-meh-teh koo-dah-sai", "note": "For a konbini bento. They often ask first.",
          "replies": [
            { "id": "atatamete-r1", "text": "少々お待ちください。", "rom": "shōshō omachi kudasai", "en": "Please wait a moment." },
            { "id": "atatamete-r2", "text": "お箸はお付けしますか？", "rom": "ohashi wa otsuke shimasu ka", "en": "Would you like chopsticks?" }
          ]
        },
        { "id": "fukuro", "en": "No bag, thanks", "text": "袋はいりません", "rom": "fukuro wa irimasen", "ph": "foo-koo-roh wah ee-ree-mah-sen", "note": "Shops charge a few yen for bags." }
      ]
    },
    {
