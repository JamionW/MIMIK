        { "id": "perdon", "en": "Sorry", "text": "Perdón", "ph": "pehr-DOHN" },
        { "id": "si-no", "en": "Yes / No", "text": "Sí / No", "say": "Sí. No.", "ph": "SEE / NOH" },
        { "id": "no-hablo", "en": "I don't speak Spanish", "text": "No hablo español", "ph": "noh AH-bloh ehs-pah-NYOHL" },
        { "id": "habla-ingles", "en": "Do you speak English?", "text": "¿Habla inglés?", "ph": "AH-blah een-GLEHS" },
        { "id": "no-entiendo", "en": "I don't understand", "text": "No entiendo", "ph": "noh ehn-TYEHN-doh" },
        { "id": "mas-despacio", "en": "More slowly, please", "text": "Más despacio, por favor", "ph": "MAHS dehs-PAH-syoh, por fah-VOR" },
        { "id": "adios", "en": "Goodbye", "text": "Adiós", "ph": "ah-DYOHS", "note": "Casual: hasta luego (AHS-tah LWEH-goh)." }
      ]
    },
    {
      "id": "around",
      "title": "Getting around",
      "phrases": [
        { "id": "bano", "en": "Where is the bathroom?", "text": "¿Dónde está el baño?", "ph": "DOHN-deh ehs-TAH el BAH-nyoh" },
        { "id": "metro", "en": "Where is the metro?", "text": "¿Dónde está el metro?", "ph": "DOHN-deh ehs-TAH el MEH-troh" },
        { "id": "esta-lejos", "en": "Is it far?", "text": "¿Está lejos?", "ph": "ehs-TAH LEH-hohs" },
        { "id": "boleto-a", "en": "A ticket to ...", "text": "Un boleto a ...", "say": "Un boleto a", "ph": "oon boh-LEH-toh ah" },
        { "id": "cuanto-cuesta", "en": "How much is it?", "text": "¿Cuánto cuesta?", "ph": "KWAHN-toh KWEHS-tah" },
        { "id": "la-cuenta", "en": "The bill, please", "text": "La cuenta, por favor", "ph": "lah KWEHN-tah, por fah-VOR", "note": "Tip about 10 to 15 percent; say it before they run the card." },
        { "id": "con-tarjeta", "en": "Can I pay by card?", "text": "¿Puedo pagar con tarjeta?", "ph": "PWEH-doh pah-GAR kohn tar-HEH-tah", "note": "Carry pesos for markets, taco stands and tips." }
      ]
    }
