  "sections": [
    {
      "id": "morning",
      "title": "Morning",
      "hours": [5, 13],
      "phrases": [
        { "id": "buenos-dias", "en": "Good morning", "text": "Buenos días", "ph": "BWEH-nohs DEE-ahs" },
        { "id": "un-cafe", "en": "A coffee, please", "text": "Un café americano, por favor", "ph": "oon kah-FEH ah-meh-ree-KAH-noh, por fah-VOR", "note": "Café de olla is the traditional one, brewed with cinnamon and piloncillo." },
        { "id": "cafe-con-leche", "en": "A coffee with milk", "text": "Un café con leche, por favor", "ph": "oon kah-FEH kohn LEH-cheh, por fah-VOR" },
        { "id": "jugo-naranja", "en": "An orange juice", "text": "Un jugo de naranja, por favor", "ph": "oon HOO-goh deh nah-RAHN-hah, por fah-VOR" },
        { "id": "chilaquiles", "en": "Chilaquiles, please", "text": "Unos chilaquiles, por favor", "ph": "OO-nohs chee-lah-KEE-lehs, por fah-VOR", "note": "They will ask verdes o rojos: green or red salsa." },
        { "id": "una-concha", "en": "A sweet bun (concha)", "text": "Una concha, por favor", "ph": "OO-nah KOHN-chah, por fah-VOR" },
        { "id": "para-llevar", "en": "To take away", "text": "Para llevar", "ph": "PAH-rah yeh-VAR", "note": "To eat here: para comer aquí (ah-KEE)." }
      ]
    },
    {
      "id": "lunch",
      "title": "Lunch",
      "hours": [13, 17],
      "phrases": [
        { "id": "buenas-tardes-l", "en": "Good afternoon (from noon)", "text": "Buenas tardes", "ph": "BWEH-nahs TAR-dehs" },
        { "id": "mesa-para-dos-l", "en": "A table for two", "text": "Una mesa para dos", "ph": "OO-nah MEH-sah PAH-rah DOHS" },
        { "id": "el-menu", "en": "The menu, please", "text": "El menú, por favor", "ph": "el meh-NOO, por fah-VOR" },
        { "id": "comida-corrida", "en": "What's on the set lunch?", "text": "¿Qué hay de comida corrida?", "ph": "keh EYE deh koh-MEE-dah koh-REE-dah", "note": "The cheap fixed lunch: soup, rice, a main, a drink." },
        { "id": "me-da-esto", "en": "I'd like this, please", "text": "Me da esto, por favor", "ph": "meh DAH EHS-toh, por fah-VOR" },
        { "id": "agua", "en": "Still / sparkling water", "text": "Agua natural / mineral", "say": "Agua natural. Agua mineral.", "ph": "AH-gwah nah-too-RAHL / mee-neh-RAHL", "note": "Agua mineral means sparkling. Drink bottled, not tap." },
        { "id": "sin-picante", "en": "Not spicy, please", "text": "Sin picante, por favor", "ph": "seen pee-KAHN-teh, por fah-VOR", "note": "A waiter's no pica can still mean a little." },
        { "id": "no-gracias", "en": "No, thank you", "text": "No, gracias", "ph": "NOH, GRAH-syahs" }
      ]
    },
    {
      "id": "afternoon",
      "title": "Afternoon",
      "hours": [17, 20],
      "phrases": [
        { "id": "buenas-tardes", "en": "Good afternoon", "text": "Buenas tardes", "ph": "BWEH-nahs TAR-dehs" },
        { "id": "una-cerveza", "en": "A beer, please", "text": "Una cerveza, por favor", "ph": "OO-nah sehr-VEH-sah, por fah-VOR", "note": "Una chela is the casual word." },
        { "id": "michelada", "en": "A michelada, please", "text": "Una michelada, por favor", "ph": "OO-nah mee-cheh-LAH-dah, por fah-VOR", "note": "Beer with lime, salt and chili sauce. A chelada is just lime and salt." },
        { "id": "dos-boletos", "en": "Two tickets, please", "text": "Dos boletos, por favor", "ph": "DOHS boh-LEH-tohs, por fah-VOR" },
        { "id": "a-que-hora-cierra", "en": "What time does it close?", "text": "¿A qué hora cierra?", "ph": "ah keh OH-rah SYEH-rah" },
        { "id": "tomar-foto", "en": "Can I take a photo?", "text": "¿Puedo tomar una foto?", "ph": "PWEH-doh toh-MAR OO-nah FOH-toh" }
      ]
    },
