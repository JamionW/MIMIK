        { "id": "vino", "en": "A glass of red / white wine", "text": "Una copa de vino tinto / blanco", "say": "Una copa de vino tinto. Una copa de vino blanco.", "ph": "OO-nah KOH-pah deh VEE-noh TEEN-toh / BLAHN-koh" },
        { "id": "mezcal", "en": "A mezcal, please", "text": "Un mezcal, por favor", "ph": "oon mehs-KAHL, por fah-VOR", "note": "Sip it; it comes with orange slices and chili salt." },
        { "id": "salud", "en": "Cheers!", "text": "¡Salud!", "ph": "sah-LOOD" },
        { "id": "estuvo-delicioso", "en": "It was delicious", "text": "Estuvo delicioso", "ph": "ehs-TOO-voh deh-lee-SYOH-soh" },
        { "id": "taxi", "en": "Can you get me a taxi?", "text": "¿Me puede pedir un taxi?", "ph": "meh PWEH-deh peh-DEER oon TAHK-see", "note": "Use an app or a taxi de sitio (from a stand) rather than hailing one." }
      ]
    },
    {
      "id": "core",
      "title": "Always",
      "phrases": [
